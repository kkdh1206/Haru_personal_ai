    "dayjs": "^1.11.13",
    "express": "^5.1.0",
    "firebase-admin": "^13.4.0",
    "googleapis": "^150.0.1",
    "ioredis": "^5.6.1",
    "livekit-client": "^2.15.7",
    "livekit-server-sdk": "^2.13.3",
    "luxon": "^3.7.1",
    "mongodb": "^6.20.0",
    "mongoose": "^8.16.1",
    "node-apn": "^3.0.0",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^3.0.2",
