AGORA_APP_ID=
AGORA_APP_CERT=

MONGO_URI=
MONGO_DB_NAME=

AGENT_URL=
# Required by the LiveKit worker for internal memory/prompt/calendar/alarm routes
AGENT_SHARED_SECRET=

# Personal assistant text generation (server-side only; never ship this key in an app)
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional Claude-compatible gateway and timeout override
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_TIMEOUT_MS=20000

# Calendar/memory/billing preflight timeout; the server caps this at 7000ms.
ASSISTANT_PREFLIGHT_TIMEOUT_MS=5000

# Per-user, per-operation fixed-window limits for paid assistant calls.
# Set an operation limit to 0 to disable its Claude calls while keeping fallbacks.
ASSISTANT_RATE_LIMIT_WINDOW_MS=3600000
ASSISTANT_BRIEFING_LIMIT=12
ASSISTANT_CHAT_LIMIT=60

APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PROD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

OWM_API_KEY=

ENCRYPTION_KEY=

LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_WEBSOCKET_URL=

CHROMA_URL=

# Billing / native App Store and Google Play
# Keep enforcement disabled until products, notifications, and both apps are live.
BILLING_ENFORCEMENT_ENABLED=false
BILLING_ENTITLEMENT_ID=haru_plus

APPLE_BUNDLE_ID=com.poapper.morningcall
APPLE_APP_ID=
APPLE_ENVIRONMENT=Sandbox
APPLE_ROOT_CA_BASE64=
APPLE_ENABLE_ONLINE_CHECKS=true
APPLE_SUBSCRIPTION_PRODUCT_ID=haru.plus.monthly

GOOGLE_PLAY_PACKAGE_NAME=com.poapper.morningcall
GOOGLE_PLAY_SUBSCRIPTION_PRODUCT_ID=haru_plus_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_NOTIFICATION_AUDIENCE=

# Optional alternative to mounting firebase-adminsdk.json
FIREBASE_SERVICE_ACCOUNT_JSON=
